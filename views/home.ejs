<% layout("/layouts/boilerplate") %>

<!-- HERO -->

<section class="hero-section">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-6">

                <span class="hero-badge">
                    🚀 Next Generation Paper Trading
                </span>

                <h1 class="hero-title mt-4">
                    Invest Smarter.
                    <br>
                    Trade Without Risk.
                </h1>

                <p class="hero-description mt-4">

                    Experience realistic paper trading,
                    portfolio analytics,
                    watchlists,
                    and intelligent investment insights —
                    all in one modern platform.

                </p>

                <div class="mt-5">

                    <a href="/register"
                       class="btn btn-primary btn-lg me-3">

                        Start Investing

                    </a>

                    <a href="/stocks/search"
                       class="btn btn-outline-primary btn-lg">

                        Explore Markets

                    </a>

                </div>

            </div>

            <div class="col-lg-6">

                <div class="hero-dashboard">

                    <div class="dashboard-header">

                        <h5>
                            Portfolio Overview
                        </h5>

                        <span class="profit">
                            ▲ +12.48%
                        </span>

                    </div>

                    <div class="portfolio-value">

                        ₹12,48,520

                    </div>

                    <div class="row mt-4">

                        <div class="col-6">

                            <div class="mini-card">

                                <small>Virtual Wallet</small>

                                <h4>₹10L</h4>

                            </div>

                        </div>

                        <div class="col-6">

                            <div class="mini-card">

                                <small>Watchlist</small>

                                <h4>24 Stocks</h4>

                            </div>

                        </div>

                    </div>

                    <div class="chart-placeholder mt-4">

                        📈 Portfolio Performance

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- FEATURES -->

<section class="container py-5">

    <div class="text-center mb-5">

        <h2 class="fw-bold">

            Everything You Need

        </h2>

        <p>

            Professional tools for smarter investing.

        </p>

    </div>

    <div class="row g-4">

        <div class="col-md-3">

            <div class="feature-card text-center">

                <i class="bi bi-wallet2 display-5"></i>

                <h5 class="mt-3">
                    Paper Trading
                </h5>

                <p>
                    Practice investing without risking money.
                </p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="feature-card text-center">

                <i class="bi bi-bar-chart-line display-5"></i>

                <h5 class="mt-3">
                    Portfolio Analytics
                </h5>

                <p>
                    Track profits, losses and allocations.
                </p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="feature-card text-center">

                <i class="bi bi-eye display-5"></i>

                <h5 class="mt-3">
                    Watchlist
                </h5>

                <p>
                    Monitor your favorite stocks.
                </p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="feature-card text-center">

                <i class="bi bi-graph-up-arrow display-5"></i>

                <h5 class="mt-3">
                    Live Market
                </h5>

                <p>
                    Explore real-time stock information.
                </p>

            </div>

        </div>

    </div>

</section>

<!-- STATS -->

<section class="container pb-5">

    <div class="stats-box">

        <div>

            <h2>500+</h2>

            <p>NSE Stocks</p>

        </div>

        <div>

            <h2>₹10L</h2>

            <p>Virtual Capital</p>

        </div>

        <div>

            <h2>24×7</h2>

            <p>Portfolio Access</p>

        </div>

        <div>

            <h2>100%</h2>

            <p>Risk Free Learning</p>

        </div>

    </div>

</section>