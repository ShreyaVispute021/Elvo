<% layout("/layouts/boilerplate") %>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">My Portfolio</h2>
            <p class="text-muted mb-0">Manage and track your investments</p>
        </div>
        <a href="/portfolio/new" class="btn btn-success px-4">
            <i class="bi bi-plus-circle"></i>
            Add Investment
        </a>
    </div>
    <div class="row mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow rounded-4">
            <div class="card-body text-center">
                <h6 class="text-muted">
                    Holdings
                </h6>
                <h2 class="fw-bold">
                    <%= totalHoldings %>
                </h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow rounded-4">
            <div class="card-body text-center">
                <h6 class="text-muted">
                    Total Shares
                </h6>
                <h2 class="fw-bold">
                    <%= totalShares %>
                </h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow rounded-4">
            <div class="card-body text-center">
                <h6 class="text-muted">
                    Total Invested
                </h6>
                <h2 class="fw-bold text-success">
                    ₹<%= totalInvested.toLocaleString() %>
                </h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow rounded-4">
            <div class="card-body text-center">
                <h6 class="text-muted">
                    Current Value
                </h6>

                <h2 class="fw-bold">
                    ₹<%= totalCurrentValue.toLocaleString() %>
                </h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow rounded-4">
            <div class="card-body text-center">
                <h6 class="text-muted">
                    Total P&L
                </h6>

                <h2 class="<%= totalPnL >= 0 ? 'text-success' : 'text-danger' %>">
                    ₹<%= totalPnL.toFixed(2) %>
                </h2>
            </div>
        </div>
    </div>
</div>
<div class="card shadow border-0 rounded-4 mb-4">
    <div class="card-body">
        <h4 class="fw-bold mb-3">
            Portfolio Allocation
        </h4>

        <canvas id="portfolioChart" height="300"></canvas>
    </div>
</div>
    <% if(investments.length === 0) { %>
    <div class="card shadow border-0 rounded-4">
        <div class="card-body text-center py-5">
            <i class="bi bi-graph-up display-1 text-muted"></i>
            <h3 class="mt-3">
                No Investments Yet
            </h3>
            <p class="text-muted">
                Start building your portfolio today.
            </p>
            <a href="/portfolio/new" class="btn btn-success">
                Add First Investment
            </a>
        </div>
    </div>
    <% } else { %>
    <div class="card shadow border-0 rounded-4">
        <div class="card-body p-4">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Stock</th>
                        <th>Quantity</th>
                        <th>Buy Price</th>
                        <th>Current Price</th>
                        <th>Total Value</th>
                        <th>P&L</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% investments.forEach(inv => { %>
                        <tr>
                            <td>
                                <span class="badge bg-primary fs-6 px-3 py-2">
                                    <%= inv.stockName %>
                                </span>
                            </td>
                            <td>
                                <strong><%= inv.quantity %></strong>
                            </td>
                            <td>
                                ₹<%= inv.buyPrice.toFixed(2) %>
                            </td>
                            <td>
                                ₹<%= inv.currentPrice.toFixed(2) %>
                            </td>
                            <td class="fw-bold text-success">
                                ₹<%= inv.currentValue.toFixed(2) %>
                            </td>
                            <td class="<%= inv.pnl >= 0 ? 'text-success' : 'text-danger' %> fw-bold">
                                ₹<%= inv.pnl.toFixed(2) %>
                            </td>
                            <td class="d-flex gap-2">
                                <a href="/stocks/<%= inv._id %>/sell" class="btn btn-danger btn-sm">
                                    Sell
                                </a>
                                <a href="/portfolio/<%= inv._id %>/edit" class="btn btn-warning btn-sm">
                                    Edit
                                </a>
                                <form action="/portfolio/<%= inv._id %>?_method=DELETE" method="POST">
                                    <button class="btn btn-danger btn-sm">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <% } %>
</div>

