<% layout("/layouts/boilerplate") %>

<div class="container py-5">
    <div class="card shadow-lg p-4">
        <h2 class="mb-3">
            Sell <%= investment.stockName %>
        </h2>
        <p>
            Available Shares:
            <strong><%= investment.quantity %></strong>
        </p>
        <form
            action="/stocks/<%= investment._id %>/sell"
            method="POST">
            <div class="mb-3">
                <label class="form-label">
                    Quantity to Sell
                </label>
                <input
                    type="number"
                    name="quantity"
                    min="1"
                    max="<%= investment.quantity %>"
                    class="form-control"
                    required>
            </div>
            <button class="btn btn-danger">
                Sell Stock
            </button>
        </form>
    </div>
</div>