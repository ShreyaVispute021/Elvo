<% layout("/layouts/boilerplate") %>

<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1"></script>
<script src="https://cdn.jsdelivr.net/npm/luxon@3"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-luxon"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-chart-financial@0.1.1"></script>
<div class="card-body p-5">
    <h1 class="fw-bold">
        <%= stock.longName %>
    </h1>
    <h2 class="text-success">
        ₹<%= stock.regularMarketPrice %>
    </h2>
    <hr>
    <div class="row">
        <div class="col-md-6">
            <p>
                <strong>Day Change:</strong>
                <%= stock.regularMarketChangePercent.toFixed(2) %>%
            </p>
            <p>
                <strong>Previous Close:</strong>
                ₹<%= stock.regularMarketPreviousClose %>
            </p>
            <p>
                <strong>Market:</strong>
                <%= stock.fullExchangeName %>
            </p>
        </div>
        <div class="col-md-6">
            <p>
                <strong>52 Week High:</strong>
                ₹<%= stock.fiftyTwoWeekHigh %>
            </p>
            <p>
                <strong>52 Week Low:</strong>
                ₹<%= stock.fiftyTwoWeekLow %>
            </p>
            <p>
                <strong>P/E Ratio:</strong>
                <%= stock.trailingPE %>
            </p>
        </div>
        <div class="card shadow-lg border-0 rounded-4 mt-4">
            <div class="card-body">
                <h4 class="mb-4">
                    Price History
                </h4>

                <canvas id="stockChart"></canvas>
            </div>
        </div>
        </div>
            <a href="/<%= stock.symbol %>/buy" class="btn btn-success btn-lg">
                Buy Stock
            </a>
            <form action="/watchlist/add" method="POST">
                <input type="hidden" name="symbol" value="<%= stock.symbol %>">

                <input type="hidden" name="companyName" value="<%= stock.longName %>">
                <button type="submit" class="btn btn-warning">
                    Add to Watchlist
                </button>
            </form>
        </div>
    </div>
</div>

<script>
const data = <%- JSON.stringify(chartData) %>;

const ctx = document.getElementById("stockChart");

new Chart(ctx, {
    type: "candlestick",
    data: {
        datasets: [{
            label: "Price",
            data: data
        }]
    },
    options: {
        parsing: false,
        scales: {
            x: {
                type: "time",
                time: {
                    unit: "day"
                }
            }
        }
    }
});
</script>