<% layout("/layouts/boilerplate") %>
<div class="container py-5">
    <div class="mb-5">
        <h1 class="fw-bold">
            Welcome back, <%= username %> 👋
        </h1>
        <p class="text-muted">
            Track your investments and grow your virtual portfolio.
        </p>
    </div>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card dashboard-card portfolio-card">
                <div class="card-body p-4">
                    <small class="text-muted">
                        Portfolio Value
                    </small>
                    <h2 class="fw-bold mt-2">
                        ₹0
                    </h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card dashboard-card wallet-card">
                <div class="card-body p-4">
                    <small class="text-muted">
                        Wallet Balance
                    </small>
                    <h2 class="fw-bold text-success mt-2">
                        ₹<%= walletBalance.toLocaleString() %>
                    </h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card dashboard-card watchlist-card">
                <div class="card-body p-4">
                    <small class="text-muted">
                        Watchlist
                    </small>
                    <h2 class="fw-bold mt-2">
                        0 Stocks
                    </h2>
                </div>
            </div>
        </div>
    </div>
    <div class="card border-0 shadow rounded-4 mt-4">
    <div class="card-body p-4">
        <h4 class="fw-bold mb-3">
            Recent Activity
        </h4>
        <% if(recentTransactions.length === 0) { %>
            <p class="text-muted">
                No transactions yet.
            </p>
        <% } else { %>
            <% recentTransactions.forEach(tx => { %>
                <div class="d-flex justify-content-between align-items-center border-bottom py-3">
                    <div>
                        <% if(tx.type === "BUY") { %>
                            <span class="badge bg-success me-2">
                                BUY
                            </span>
                        <% } else { %>
                            <span class="badge bg-danger me-2">
                                SELL
                            </span>
                        <% } %>
                        <strong><%= tx.stockName %></strong>
                    </div>
                    <div class="text-end">
                        <div>
                            <%= tx.quantity %> Shares
                        </div>
                        <small class="text-muted">
                            ₹<%= tx.price %>
                        </small>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>
</div>
    <div class="card border-0 shadow rounded-4 mt-5">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-3">
                Quick Actions
            </h4>
            <div class="d-flex gap-3">
                <a href="/portfolio/new" class="btn btn-success">
                    Add Investment
                </a>
                <a href="/watchlist/new" class="btn btn-primary">
                    Add To Watchlist
                </a>
                <a href="/transactions" class="btn btn-dark">
                    Transactions
                </a>
            </div>
        </div>
    </div>
</div>